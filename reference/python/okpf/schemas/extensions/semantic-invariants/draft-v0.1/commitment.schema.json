{
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Copyright 2026 OKPF Contributors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft semantic invariant commitment artifact",
  "type": "object",
  "required": [
    "extension",
    "status",
    "taxonomy_bindings",
    "operational_test"
  ],
  "properties": {
    "extension": {
      "const": "okpf.semantic_invariants.draft.v0.1"
    },
    "status": {
      "const": "draft"
    },
    "taxonomy_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "taxonomy_version",
          "definition",
          "definition_sha256",
          "source_reference"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "taxonomy_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    },
    "operational_test": {
      "type": "object",
      "required": [
        "metric_id",
        "concept_ids",
        "population",
        "numerator",
        "denominator",
        "unit",
        "operator",
        "threshold",
        "evaluation_horizon_months",
        "measurement_method",
        "data_source",
        "missing_data_policy",
        "owner",
        "fallback_action"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "concept_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "population": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "numerator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "denominator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operator": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq"
          ]
        },
        "threshold": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "evaluation_horizon_months": {
          "type": "integer",
          "minimum": 1
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "data_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "missing_data_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fallback_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
